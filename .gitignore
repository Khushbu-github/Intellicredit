# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/

# ---- Databases (local dev only; production uses Postgres) ----
*.db
*.sqlite
*.sqlite3

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Uploaded borrower documents (never commit customer data) ----
files/
!files/.gitkeep
backend/files/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ---- Test & coverage ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Editors & OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Generated demo fixtures (recreate with scripts/generate_demo_data.py)
backend/samples/*
!backend/samples/.gitkeep
