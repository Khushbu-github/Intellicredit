# Copy to .env and fill in. .env is gitignored - never commit real values.

ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local development uses SQLite. In production set the Supabase/Neon pooled
# Postgres URL, e.g.
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase shows this under Project Settings -> Database -> Connection string
# (choose "Transaction pooler" / port 6543 and the URI tab). Note the
# "+psycopg" driver suffix - SQLAlchemy needs it to use psycopg3.
DATABASE_URL=sqlite:///./intellicredit.db

# Comma-separated. Vercel previews are matched by ALLOWED_ORIGIN_REGEX.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=files
MAX_UPLOAD_BYTES=15728640

# Optional. Without it every model-assisted feature is disabled and the app
# falls back to its deterministic parsers - it stays fully functional.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
