# Copy to .env and fill in. .env is gitignored - never commit real values.

ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Local development uses SQLite. In production set the Supabase/Neon pooled
# Postgres URL, e.g.
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase shows this under Project Settings -> Database -> Connection string
# (choose "Transaction pooler" / port 6543 and the URI tab). Note the
# "+psycopg" driver suffix - SQLAlchemy needs it to use psycopg3.
DATABASE_URL=sqlite:///./intellicredit.db

# JSON array (required by pydantic-settings for list fields). Vercel previews are matched by ALLOWED_ORIGIN_REGEX.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

UPLOAD_DIR=files
MAX_UPLOAD_BYTES=15728640

# Rate limiting. Counters live in process memory by default; point
# RATE_LIMIT_STORAGE_URI at Redis if the API ever runs on more than one
# instance, or each instance will keep its own separate count.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_LLM=20/hour
RATE_LIMIT_UPLOAD=60/hour

# Reverse proxies in front of the app: 0 locally, 1 behind Render. Setting
# this higher than the real number lets clients spoof X-Forwarded-For and
# sidestep the limits entirely.
TRUSTED_PROXY_HOPS=0

# Optional. Without it every model-assisted feature is disabled and the app
# falls back to its deterministic parsers - it stays fully functional.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
